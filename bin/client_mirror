#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${MIRROR_STATE_DIR:-"$HOME/.local/state/terminal-mirror"}"
SESSION_NAME="${1:-"mirror-$(date +%Y%m%d-%H%M%S)"}"
DISPLAY_NAME="${MIRROR_DISPLAY_NAME:-$SESSION_NAME}"
TMUX_WINDOW_SIZE="${MIRROR_TMUX_WINDOW_SIZE:-largest}"
SESSION_ID="$(printf '%s' "$SESSION_NAME" | tr -c 'A-Za-z0-9._-' '-' | sed -E 's/^-+|-+$//g')"

if [[ -z "$SESSION_ID" ]]; then
  echo "session id is empty after sanitizing session name" >&2
  exit 2
fi

SOCKET_DIR="$STATE_DIR/sockets"
SESSION_DIR="$STATE_DIR/sessions"
LOG_DIR="$STATE_DIR/logs"
SOCKET_PATH="$SOCKET_DIR/$SESSION_ID.sock"
SESSION_FILE="$SESSION_DIR/$SESSION_ID.json"
LOG_FILE="$LOG_DIR/$SESSION_ID.log"

if [[ "${#SOCKET_PATH}" -gt 100 ]]; then
  echo "socket path is too long for a Unix domain socket: $SOCKET_PATH" >&2
  echo "use a shorter MIRROR_STATE_DIR or session name" >&2
  exit 2
fi

mkdir -p "$SOCKET_DIR" "$SESSION_DIR" "$LOG_DIR"
chmod 700 "$STATE_DIR" "$SOCKET_DIR" "$SESSION_DIR" "$LOG_DIR"

if ! command -v tmux >/dev/null 2>&1; then
  echo "tmux is required" >&2
  exit 127
fi

if ! command -v ttyd >/dev/null 2>&1; then
  echo "ttyd is required" >&2
  exit 127
fi

if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  tmux new-session -d -s "$SESSION_NAME" -c "$PWD"
fi
tmux set-option -w -t "$SESSION_NAME:" window-size "$TMUX_WINDOW_SIZE" >/dev/null

needs_ttyd=1
if [[ -f "$SESSION_FILE" ]]; then
  existing_pid="$(sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$SESSION_FILE" | head -1)"
  if [[ -n "${existing_pid:-}" ]] && kill -0 "$existing_pid" 2>/dev/null && [[ -S "$SOCKET_PATH" ]]; then
    needs_ttyd=0
  fi
fi

if [[ "$needs_ttyd" -eq 1 ]]; then
  rm -f "$SOCKET_PATH"
  nohup ttyd -W -i "$SOCKET_PATH" -b "/terminal/$SESSION_ID" tmux attach-session -t "$SESSION_NAME" >"$LOG_FILE" 2>&1 &
  ttyd_pid="$!"
  for _ in $(seq 1 50); do
    [[ -S "$SOCKET_PATH" ]] && break
    sleep 0.1
  done
  if ! kill -0 "$ttyd_pid" 2>/dev/null || [[ ! -S "$SOCKET_PATH" ]]; then
    echo "ttyd did not start for session $SESSION_NAME; see $LOG_FILE" >&2
    exit 1
  fi
else
  ttyd_pid="$existing_pid"
fi

created_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
escaped_pwd="$(printf '%s' "$PWD" | sed 's/\\/\\\\/g; s/"/\\"/g')"
escaped_name="$(printf '%s' "$DISPLAY_NAME" | sed 's/\\/\\\\/g; s/"/\\"/g')"
escaped_tmux="$(printf '%s' "$SESSION_NAME" | sed 's/\\/\\\\/g; s/"/\\"/g')"

tmp_file="$SESSION_FILE.tmp"
cat >"$tmp_file" <<JSON
{
  "id": "$SESSION_ID",
  "name": "$escaped_name",
  "tmuxName": "$escaped_tmux",
  "socket": "$SOCKET_PATH",
  "pid": $ttyd_pid,
  "cwd": "$escaped_pwd",
  "createdAt": "$created_at"
}
JSON
mv "$tmp_file" "$SESSION_FILE"
chmod 600 "$SESSION_FILE"

if [[ "${MIRROR_NO_ATTACH:-}" == "1" ]]; then
  printf '%s\n' "$SESSION_ID"
  exit 0
fi

exec tmux attach-session -t "$SESSION_NAME"
