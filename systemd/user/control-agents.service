[Unit]
Description=Control Agents
After=network.target

[Service]
Type=simple
Environment=MIRROR_BIND_ADDR=0.0.0.0
Environment=MIRROR_PORT=8080
Environment=MIRROR_STATE_DIR=%h/.local/state/terminal-mirror
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/terminal-mirror/env
ExecStart=%h/.local/bin/control-agents
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
